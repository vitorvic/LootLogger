<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the icon next to the clock (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the project also build on Linux/macOS (CI); it still only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>LootLogger</AssemblyName>
    <RootNamespace>LootLogger.App</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <StartupObject>LootLogger.App.Program</StartupObject>
    <Product>LootLogger</Product>
    <Authors>Vitor</Authors>
    <Copyright>GPL-3.0</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep WPF names (Application, MessageBox...) unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LootLogger.Core\LootLogger.Core.csproj" />
    <ProjectReference Include="..\LootLogger.Capture\LootLogger.Capture.csproj" />
  </ItemGroup>

</Project>

<Window x:Class="LootLogger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:LootLogger.App.Localization"
        xmlns:vm="clr-namespace:LootLogger.App.ViewModels"
        xmlns:views="clr-namespace:LootLogger.App.Views"
        Title="LootLogger" Width="1120" Height="720" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/icon.ico"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}"
        FontFamily="{StaticResource AppFont}" FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        WindowStyle="None" ResizeMode="CanResize"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Frame" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Soft gold glow in the top right corner -->
            <Ellipse Grid.RowSpan="3" Width="760" Height="560" Fill="{StaticResource GlowBrush}" IsHitTestVisible="False"
                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-300,-220,0" />

            <!-- Title bar -->
            <Border Grid.Row="0" Background="Transparent" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Image Source="pack://application:,,,/Assets/icon.png" Width="20" Height="20" />
                        <TextBlock Text="LootLogger" FontWeight="SemiBold" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <Border Style="{StaticResource TitleSeparator}" />

                        <!-- Before the game sends the player -->
                        <TextBlock Text="{l:T WaitingGame}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                   Visibility="{Binding IsPlayerIdentified, Converter={StaticResource FalseToVisible}}" />

                        <!-- Player, guild, alliance and map -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsPlayerIdentified, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Player.Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding GuildText}" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasCluster, Converter={StaticResource BoolToVisibility}}">
                                <Border Style="{StaticResource TitleSeparator}" />
                                <Border Style="{StaticResource TierChip}" Visibility="{Binding HasTier, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding TierText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" />
                                </Border>
                                <TextBlock Text="{Binding ClusterName}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <!-- Status dots: green when known, gold while waiting -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource GoldBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlayerIdentified}" Value="True">
                                                <Setter Property="TextElement.Foreground" Value="{StaticResource GreenBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Ellipse Width="7" Height="7" Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=StackPanel}}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding InGameText}" FontSize="11.5" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="12,0,0,0"
                                        Visibility="{Binding IsServerKnown, Converter={StaticResource BoolToVisibility}}">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ServerText}" FontSize="11.5" Foreground="{StaticResource GreenBrush}" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <Button Style="{StaticResource TitleBarButton}" Click="OnMinimize" ToolTip="Minimizar">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                        </Button>
                        <Button Style="{StaticResource TitleBarButton}" Click="OnMaximize" ToolTip="Maximizar">
                            <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                        </Button>
                        <Button Style="{StaticResource TitleBarButton}" Click="OnClose" ToolTip="Fechar (continua capturando perto do relógio)">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Menu tabs -->
            <DockPanel Grid.Row="1" Margin="16,12,16,0">
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"
                           FontFamily="{StaticResource MonoFont}" Text="{Binding Version, StringFormat=v{0}}" />
                <Border HorizontalAlignment="Left" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Content="{l:T NavDashboard}"
                                     IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:Page.Dashboard}}" />
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Content="{l:T NavLootLog}"
                                     IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:Page.LootLog}}" />
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Content="{l:T NavChest}"
                                     IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:Page.Chest}}" />
                        <Border Width="1" Height="16" Margin="6,0" Background="{StaticResource LineBrush}" VerticalAlignment="Center" />
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Content="{l:T NavSettings}"
                                     IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:Page.Settings}}" />
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Content="{l:T NavHelp}"
                                     IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:Page.Help}}" />
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Content="{l:T NavAbout}"
                                     IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:Page.About}}" />
                    </StackPanel>
                </Border>
            </DockPanel>

            <!-- Pages -->
                <Grid Grid.Row="2" Margin="16,14,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <views:DashboardView Visibility="{Binding Page, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:Page.Dashboard}}" />
                    <views:LootLogView Visibility="{Binding Page, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:Page.LootLog}}" />
                    <views:ChestView Visibility="{Binding Page, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:Page.Chest}}" />
                    <views:SettingsView Visibility="{Binding Page, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:Page.Settings}}" />
                    <views:InfoView Visibility="{Binding Page, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:Page.Help}}" Mode="Help" />
                    <views:InfoView Visibility="{Binding Page, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:Page.About}}" Mode="About" />

                    <!-- One-line message (export done, errors) -->
                    <Border Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource Card}" Padding="12,8"
                            Visibility="{Binding Message, Converter={StaticResource TextToVisible}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="✕" Click="OnDismissMessage" Margin="12,0,0,0" />
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </Grid>
        </Grid>
    </Border>
</Window>

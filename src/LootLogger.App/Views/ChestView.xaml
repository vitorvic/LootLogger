<UserControl x:Class="LootLogger.App.Views.ChestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:LootLogger.App.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitle}" Text="{l:T NavChest}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource GoButton}" Content="{l:T PasteChestLog}" Command="{Binding PasteChestLogCommand}" Margin="0,0,8,0" />
                <Button Content="{l:T OpenFile}" Command="{Binding OpenChestFileCommand}" Margin="0,0,8,0" />
                <Button Content="{l:T ClearChest}" Command="{Binding ClearChestCommand}" />
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="{l:T ChestHowTo}" />
            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource GoldBrush}" Text="{Binding ChestMessage}"
                       Visibility="{Binding ChestMessage, Converter={StaticResource TextToVisible}}" />
        </StackPanel>

        <UniformGrid Grid.Row="2" Columns="4" Margin="0,14,0,0">
            <Border Style="{StaticResource Tile}" Margin="0,0,5,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="{l:T TileSessionLoot}" />
                    <TextBlock Style="{StaticResource TileValue}" Text="{Binding ChestLoot}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}" Margin="5,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="{l:T TileDeposited}" />
                    <TextBlock Style="{StaticResource TileValue}" Foreground="{StaticResource GreenBrush}" Text="{Binding ChestDeposited}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}" Margin="5,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="{l:T TileMissing}" />
                    <TextBlock Style="{StaticResource TileValue}" Foreground="{StaticResource RedBrush}" Text="{Binding ChestMissing}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}" Margin="5,0,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="{l:T TileMissingValue}" />
                    <TextBlock Style="{StaticResource TileValue}">
                        <Run Text="{Binding ChestMissingValue, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding ChestMissingValueUnit, Mode=OneWay}" FontSize="14" FontWeight="Medium" Foreground="{StaticResource MutedBrush}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource CardHeaderText}" Text="{l:T SortedByMissing}" />
                        <TextBlock Style="{StaticResource CardHeaderText}" Text="{l:T ByPlayer}" />
                    </DockPanel>
                </Border>
                <Border DockPanel.Dock="Top" Padding="10,6" BorderBrush="{StaticResource RowLineBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="2.6*" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource ColumnHeader}" Text="{l:T ColPlayer}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeader}" Text="{l:T ColLooted}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeader}" Text="{l:T ColDeposited}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeader}" Text="{l:T ColMissing}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeader}" Text="{l:T ColMissingItems}" Margin="16,0,0,0" />
                        <TextBlock Grid.Column="5" Style="{StaticResource ColumnHeader}" Text="{l:T ColStatus}" />
                    </Grid>
                </Border>
                <ListBox Style="{StaticResource RowList}" ItemsSource="{Binding ChestRows}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="2.6*" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Run Text="{Binding Player, Mode=OneWay}" FontWeight="SemiBold" /> <Run Text="{Binding Guild, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="{Binding Looted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Deposited}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Missing}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOk}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="4" Text="{Binding MissingItems}" ToolTip="{Binding MissingItems}" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource MutedBrush}" Margin="16,0,8,0" VerticalAlignment="Center" />
                                <Border Grid.Column="5" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                            <Setter Property="BorderBrush" Value="{StaticResource RedDimBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOk}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource GreenDimBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPartial}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource GoldDimBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource ChipText}">
                                                <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOk}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsPartial}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

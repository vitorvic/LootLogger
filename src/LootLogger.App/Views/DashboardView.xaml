<UserControl x:Class="LootLogger.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:LootLogger.App.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title, party and actions -->
        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{l:T ExportCsv}" Command="{Binding ExportCsvCommand}" Margin="0,0,8,0" />
                <Button Content="{l:T NewSession}" Command="{Binding NewSessionCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource PageTitle}" Text="{l:T NavDashboard}" />
                <Border Style="{StaticResource Chip}" BorderBrush="{StaticResource GreenDimBrush}" Margin="12,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding IsPlayerIdentified, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource ChipText}" Foreground="{StaticResource GreenBrush}" Text="{Binding PartyText}" />
                </Border>
            </StackPanel>
        </DockPanel>

        <!-- Tiles -->
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,14,0,0">
            <Border Style="{StaticResource Tile}" Margin="0,0,5,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="{l:T TileItems}" />
                    <TextBlock Style="{StaticResource TileValue}" Text="{Binding TotalItems}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}" Margin="5,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="{l:T TileLastHour}" />
                    <TextBlock Style="{StaticResource TileValue}" Text="{Binding LastHourItems}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}" Margin="5,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="{l:T TileActive}" />
                    <TextBlock Style="{StaticResource TileValue}">
                        <Run Text="{Binding ActiveTime, Mode=OneWay}" /><Run Text="{Binding ActiveSeconds, Mode=OneWay}" FontSize="14" FontWeight="Medium" Foreground="{StaticResource MutedBrush}" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}" Margin="5,0,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="{l:T TileValue}" />
                    <TextBlock Style="{StaticResource TileValue}">
                        <Run Text="{Binding TotalValue, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding TotalValueUnit, Mode=OneWay}" FontSize="14" FontWeight="Medium" Foreground="{StaticResource MutedBrush}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Recent events -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource CardHeaderText}" Text="{Binding ClusterName}" />
                        <TextBlock Style="{StaticResource CardHeaderText}" Text="{l:T RecentEvents}" />
                    </DockPanel>
                </Border>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="12,10,12,4" Text="{l:T NoEventsYet}"
                               Visibility="{Binding HasFeed, Converter={StaticResource FalseToVisible}}" />
                    <ListBox Style="{StaticResource RowList}" ItemsSource="{Binding Feed}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsKill}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsInfo}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="{Binding Who, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{Binding Middle, Mode=OneWay}" /><Run Text="{Binding Highlight, Mode=OneWay}" Foreground="{StaticResource GoldBrush}" /><Run Text="{Binding Suffix, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

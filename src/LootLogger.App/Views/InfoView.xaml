<UserControl x:Class="LootLogger.App.Views.InfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:LootLogger.App.Localization">
    <UserControl.Resources>
        <Style x:Key="Question" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>
        <Style x:Key="Answer" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="LineHeight" Value="19" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Novidades -->
        <DockPanel x:Name="NewsPanel" Visibility="Collapsed">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="{l:T NavNews}" />
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,16" VerticalAlignment="Top">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource Chip}" BorderBrush="{StaticResource GoldDimBrush}">
                            <TextBlock Style="{StaticResource ChipText}" Foreground="{StaticResource GoldBrush}" Text="{Binding Version, StringFormat=v{0}}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Answer}" Foreground="{StaticResource FgBrush}" Margin="0,10,0,0" Text="{l:T NewsBody}" />
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- Ajuda -->
        <DockPanel x:Name="HelpPanel" Visibility="Collapsed">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="{l:T NavHelp}" />
            <ScrollViewer Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource Card}" Padding="18,4,18,16" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Question}" Text="{l:T HelpNoCapture}" />
                        <TextBlock Style="{StaticResource Answer}" Text="{l:T HelpNoCaptureText}" />
                        <TextBlock Style="{StaticResource Question}" Text="{l:T HelpExitLag}" />
                        <TextBlock Style="{StaticResource Answer}" Text="{l:T HelpExitLagText}" />
                        <TextBlock Style="{StaticResource Question}" Text="{l:T HelpPlayer}" />
                        <TextBlock Style="{StaticResource Answer}" Text="{l:T HelpPlayerText}" />
                        <TextBlock Style="{StaticResource Question}" Text="{l:T HelpWarning}" />
                        <TextBlock Style="{StaticResource Answer}" Text="{l:T HelpWarningText}" />
                        <TextBlock Style="{StaticResource Question}" Text="{l:T HelpMerge}" />
                        <TextBlock Style="{StaticResource Answer}" Text="{l:T HelpMergeText}" />
                        <TextBlock Style="{StaticResource Question}" Text="{l:T HelpFiles}" />
                        <TextBlock Style="{StaticResource Answer}" Text="{l:T HelpFilesText}" />
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </DockPanel>

        <!-- Sobre -->
        <DockPanel x:Name="AboutPanel" Visibility="Collapsed">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="{l:T NavAbout}" />
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,18" VerticalAlignment="Top">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/icon.png" Width="44" Height="44" />
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="LootLogger" FontSize="20" FontWeight="Bold" />
                            <TextBlock Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" Text="{Binding Version, StringFormat=v{0}}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Answer}" Foreground="{StaticResource FgBrush}" Margin="0,16,0,0" Text="{l:T AboutMadeBy}" />
                    <TextBlock Style="{StaticResource Answer}" Margin="0,10,0,0" Text="{l:T AboutLicense}" />
                    <TextBlock Style="{StaticResource Answer}" Margin="0,10,0,0" Text="{l:T AboutCredits}" />
                    <TextBlock Style="{StaticResource Answer}" Margin="0,10,0,0" FontSize="11.5" Text="{l:T AboutFanProject}" />
                </StackPanel>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>

<UserControl x:Class="LootLogger.App.Views.LootLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:LootLogger.App.Localization">
    <UserControl.Resources>
        <!-- Item picture (dark square until it downloads) with the tier in the corner -->
        <DataTemplate x:Key="ItemIcon">
            <Grid Width="42" Height="42">
                <Border Style="{StaticResource ItemIconFrame}">
                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" Margin="1" />
                </Border>
                <Border Style="{StaticResource IconTier}" Visibility="{Binding Tier, Converter={StaticResource TextToVisible}}">
                    <TextBlock Text="{Binding Tier}" FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="{StaticResource GoldBrush}" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- One "who looted most" line: rank, name, bar, number -->
        <DataTemplate x:Key="RankLine">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="64" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Rank}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="Name" Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" VerticalAlignment="Center" />
                <Border Grid.Column="2" Height="6" CornerRadius="3" Background="#14FFFFFF" VerticalAlignment="Center">
                    <Border x:Name="Bar" CornerRadius="3" Background="{StaticResource BlueBrush}" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding BarFraction}" />
                        </Border.RenderTransform>
                    </Border>
                </Border>
                <TextBlock Grid.Column="3" Text="{Binding AmountText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMine}" Value="True">
                    <Setter TargetName="Name" Property="Foreground" Value="{StaticResource GoldBrush}" />
                    <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="Bar" Property="Background" Value="{StaticResource GoldBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="StatsCardTitle" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title, List / Statistics tabs, filters -->
        <DockPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitle}" Text="{l:T NavLootLog}" />
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7" Margin="14,0,0,0" VerticalAlignment="Center" ClipToBounds="True">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="LootTab" Content="{l:T TabList}" IsChecked="{Binding ShowLootStats, Converter={StaticResource Not}}" />
                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="LootTab" Content="{l:T TabStats}" IsChecked="{Binding ShowLootStats}" />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Visibility="{Binding ShowLootStats, Converter={StaticResource FalseToVisible}}">
                <Grid Width="200" Margin="0,0,4,0">
                    <TextBox x:Name="Search" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{l:T SearchHint}" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding Text, ElementName=Search, Converter={StaticResource FalseToVisible}}" />
                </Grid>
                <Border Style="{StaticResource SegmentBox}" Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource FilterChip}" GroupName="LootFilter" Content="{l:T FilterAll}"
                                     IsChecked="{Binding LootFilter, Converter={StaticResource Equals}, ConverterParameter=All}" />
                        <RadioButton Style="{StaticResource FilterChip}" GroupName="LootFilter" Content="{l:T FilterMine}"
                                     IsChecked="{Binding LootFilter, Converter={StaticResource Equals}, ConverterParameter=Mine}" />
                        <RadioButton Style="{StaticResource FilterChip}" GroupName="LootFilter" Content="{l:T FilterMyGuild}"
                                     IsChecked="{Binding LootFilter, Converter={StaticResource Equals}, ConverterParameter=MyGuild}" />
                    </StackPanel>
                </Border>
                <Button Content="{l:T ExportCsv}" Command="{Binding ExportCsvCommand}" Margin="10,0,0,0" />
                <Button Content="{l:T NewSession}" Command="{Binding NewSessionCommand}" Margin="8,0,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- List -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0"
                Visibility="{Binding ShowLootStats, Converter={StaticResource FalseToVisible}}">
            <ListBox Style="{StaticResource RowList}" ItemsSource="{Binding LootView}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="Row" Margin="-10,-6" Background="Transparent">
                            <Grid Margin="14,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Time}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="Who" Text="{Binding LootedBy}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding LootedByGuild}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <DockPanel Grid.Column="2" Margin="0,0,12,0">
                                    <ContentPresenter DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource ItemIcon}" Margin="0,0,12,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding QuantityAndName}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding FromLine}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock x:Name="Value" Grid.Column="3" Text="{Binding Value}" FontWeight="Medium" Foreground="{StaticResource GoldBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="70" TextAlignment="Right" />
                            </Grid>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMine}" Value="True">
                                <Setter TargetName="Who" Property="Foreground" Value="{StaticResource GoldBrush}" />
                                <Setter TargetName="Row" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#1AE0A63A" Offset="0" />
                                            <GradientStop Color="#00E0A63A" Offset="0.4" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasValue}" Value="False">
                                <Setter TargetName="Value" Property="Foreground" Value="{StaticResource MutedBrush}" />
                                <Setter TargetName="Value" Property="FontWeight" Value="Normal" />
                                <Setter TargetName="Value" Property="FontSize" Value="12" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Statistics -->
        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding ShowLootStats, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <UniformGrid Columns="4">
                    <Border Style="{StaticResource Tile}" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="{l:T StatsItems}" />
                            <TextBlock Style="{StaticResource TileValue}" Text="{Binding StatsItems}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}" Margin="6,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="{l:T StatsValue}" />
                            <TextBlock Style="{StaticResource TileValue}" Text="{Binding StatsValue}" Foreground="{StaticResource GoldBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}" Margin="6,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="{l:T StatsPlayers}" />
                            <TextBlock Style="{StaticResource TileValue}" Text="{Binding StatsPlayers}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="{l:T StatsMine}" />
                            <TextBlock Style="{StaticResource TileValue}" Text="{Binding StatsMine}" Foreground="{StaticResource GoldBrush}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock Style="{StaticResource Muted}" Text="{l:T StatsEmpty}" Margin="2,16,0,0">
                    <TextBlock.Visibility>
                        <Binding Path="LootRows.Count" Converter="{StaticResource Equals}" ConverterParameter="0" />
                    </TextBlock.Visibility>
                </TextBlock>

                <UniformGrid Columns="3" Margin="0,12,0,0">
                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatsCardTitle}" Text="{l:T TopByItems}" />
                            <ItemsControl ItemsSource="{Binding TopByItems}" ItemTemplate="{StaticResource RankLine}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="6,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatsCardTitle}" Text="{l:T TopByValue}" />
                            <ItemsControl ItemsSource="{Binding TopByValue}" ItemTemplate="{StaticResource RankLine}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatsCardTitle}" Text="{l:T TopItems}" />
                            <ItemsControl ItemsSource="{Binding TopItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,10">
                                            <ContentPresenter DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource ItemIcon}" Margin="0,0,10,0" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ItemName}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding LootedBy}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Style="{StaticResource Muted}" Margin="2,8,0,0" Text="{Binding LootSummary}" />
    </Grid>
</UserControl>
